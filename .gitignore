node_modules/
dist/
.env
*.log
.DS_Store

# Rust build artifacts
native/target/
native/*.node

# @napi-rs/cli generated JS bindings (built in CI, not committed)
native/index.js
native/index.d.ts

# release-time artifact — generated by CI sign-manifest job, not tracked in VCS
native/integrity.json

# Never commit — anchored at repo root so we do NOT accidentally ignore
# legitimate nested directories like `src/engine/trust/secrets/` (which
# holds SecretsProvider implementations — source code, not credentials).
/secrets/
*.private.pem

# Runtime / per-instance state (epoch store and friends)
.chariot-catalog-epoch.json
# chariot-current.json + chariot-versions/<hash>/ are published artifacts
# referenced by package.json#files and by test/chariot-artifacts.mjs.
# The version dir pointed to by chariot-current.json must be committed
# so CI tests + npm publish can find it. Other historical version dirs
# remain ignored via the chariot-versions/* glob below.
chariot-versions/*
!chariot-versions/9aa993fa555b536c38451f84f4df0735f5f13e7c483ee4b1e0b272a28d713bb5/

# CI-only artifact stage dirs. The release workflow's publish-main job
# downloads canonical binaries + the signed manifest into these paths
# before `npm publish`. prepublishOnly refuses to publish with a dirty
# tree, so these must not surface as untracked.
download-canonical/
download-manifest/
build-binaries/
platform-binaries/
sibling-pkg/
release-assets/
.publish-staging/

# Eval suite ephemeral outputs
test/ai-evals/_artifacts/
# Internal docs ignored, but public integrator-facing spec must ship.
# Use `docs/*` (not `docs/`) so the negation below can re-include a file.
docs/*
!docs/CHARIOT-SPEC.md
# Operator-facing public docs that integrators MUST read at install/runtime.
# Every file added here ships publicly — verify no internal paths,
# credentials, or unverified citations before committing.
!docs/operator/
!docs/operator/*
!docs/grafana/
!docs/grafana/*
**/last-run-report.json
# verify-dependency-provenance.mjs writes a structured run summary on
# every invocation. Without this ignore, the file's presence in the
# working tree trips the prepublishOnly dirty-tree gate (chicken-and-
# egg: the gate runs the verifier which generates the file which then
# fails the gate on the next publish attempt).
scripts/.dep-provenance-last.json

# Sensitive internal detection patterns — stored outside the repo;
# resolved at commit time via the hook's fallback chain.
.leak-denylist/

# internal-only: evals served from the private companion repo
test/
tsconfig.tsbuildinfo
